# Copy this file to .env.local and fill in your values
# .env.local is gitignored and should NEVER be committed

GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Gemini a usar en los endpoints de IA (chat, financial-bot, financialConclusion).
# Default si no se define: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# HTTP trigger URL of the "RIF-Analytic BOT Pagina Web" Power Automate flow
# (executes the suggested DAX query against the Power BI dataset). Server-only, never expose to the client.
POWER_AUTOMATE_DAX_URL=your_power_automate_http_trigger_url_here

# Endpoint (Lovable) that receives Bot Financiero registrations (nombre, correo, empresa) once a
# user hits the free query limit. Server-only.
# Dev:  https://project--8c437f5c-5331-4c90-bceb-894b25af5d1c-dev.lovable.app/api/public/registrations
# Prod: https://project--8c437f5c-5331-4c90-bceb-894b25af5d1c.lovable.app/api/public/registrations (use once the Lovable app is published)
LOVABLE_REGISTRATIONS_URL=your_lovable_registrations_endpoint_here
