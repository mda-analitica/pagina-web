---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Verticales from "../components/Verticales.astro";
import IntelligenceHub from "../components/IntelligenceHub.astro";
import BlogPreview from "../components/BlogPreview.astro";
import Footer from "../components/Footer.astro";
import Chatbot from "../components/Chatbot";
---

<Layout
  title="MDA Analítica - Información Financiera a un Solo Clíc | RIF-Analytic"
  description="Usamos los datos oficiales de la Supersolidaria. Somos la analítica de las cooperativas, fondos de empleados y asociaciones mutuales de Colombia."
>
  <Header />

  <main>
    <Hero />
    <Verticales />
    <IntelligenceHub />
    <!-- <BlogPreview /> -->
  </main>

  <Footer />

  <!-- Chatbot React component with client-side hydration -->
  <Chatbot client:load />
</Layout>
