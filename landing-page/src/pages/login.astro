---
import "../styles/global.css";
import {
  ArrowLeft,
  Moon,
  Sun,
  Eye,
  EyeOff,
  Gavel,
  ShieldCheck,
  Lock,
  Sparkles,
} from "lucide-react";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MDA Analítica - Secure Login</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      .geometric-pattern {
        background-image: radial-gradient(
          circle at 2px 2px,
          rgba(255, 255, 255, 0.05) 1px,
          transparent 0
        );
        background-size: 40px 40px;
      }
    </style>
  </head>
  <body
    class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-gray-100 font-display transition-colors duration-300 min-h-screen flex flex-col"
  >
    <!-- Theme toggle -->
    <nav class="fixed top-0 left-0 right-0 p-6 flex justify-between z-50">
      <a
        href="/"
        class="flex items-center gap-2 text-primary dark:text-blue-400 font-bold hover:opacity-80 transition-opacity"
      >
        <ArrowLeft size={20} />
        Volver al inicio
      </a>
      <button
        id="theme-toggle"
        class="flex items-center justify-center rounded-lg h-10 w-10 bg-white/80 dark:bg-slate-800/80 backdrop-blur shadow-sm border border-gray-200 dark:border-slate-700 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors"
        aria-label="Toggle dark mode"
      >
        <div class="dark:hidden">
          <Moon size={20} />
        </div>
        <div class="hidden dark:block">
          <Sun size={20} />
        </div>
      </button>
    </nav>

    <main class="grow flex items-center justify-center p-4 lg:p-0">
      <div
        class="w-full max-w-[1100px] h-full lg:h-[700px] bg-white dark:bg-slate-900 rounded-3xl shadow-2xl overflow-hidden flex flex-col lg:flex-row border border-gray-200 dark:border-slate-800"
      >
        <!-- Left panel - Decorative -->
        <div
          class="hidden lg:flex flex-1 bg-[#0a192f] relative overflow-hidden items-center justify-center p-12"
        >
          <div class="absolute inset-0 geometric-pattern opacity-40"></div>
          <div
            class="absolute inset-0 bg-linear-to-br from-primary/20 to-transparent"
          >
          </div>
          <div class="relative z-10 w-full">
            <div class="space-y-6">
              <div class="flex items-center gap-4 animate-pulse">
                <div class="w-12 h-2 bg-blue-500/30 rounded"></div>
                <div class="flex-1 h-0.5 bg-blue-500/10"></div>
              </div>
              <div
                class="h-48 border-l-2 border-b-2 border-blue-500/20 relative"
              >
                <svg
                  class="absolute bottom-0 left-0 w-full h-full text-blue-400/20"
                  preserveAspectRatio="none"
                  viewBox="0 0 100 100"
                >
                  <path
                    d="M0 80 Q 20 20 40 50 T 80 10 T 100 60 L 100 100 L 0 100 Z"
                    fill="currentColor"></path>
                </svg>
              </div>
              <div class="grid grid-cols-3 gap-4">
                <div
                  class="h-16 bg-white/5 rounded-xl border border-white/10 flex flex-col justify-center px-4"
                >
                  <span
                    class="text-[10px] text-blue-300 font-bold uppercase tracking-wider"
                    >Security</span
                  >
                  <span class="text-white font-black">99.9%</span>
                </div>
                <div
                  class="h-16 bg-white/5 rounded-xl border border-white/10 flex flex-col justify-center px-4"
                >
                  <span
                    class="text-[10px] text-blue-300 font-bold uppercase tracking-wider"
                    >Analytics</span
                  >
                  <span class="text-white font-black">AES-256</span>
                </div>
                <div
                  class="h-16 bg-white/5 rounded-xl border border-white/10 flex flex-col justify-center px-4"
                >
                  <span
                    class="text-[10px] text-blue-300 font-bold uppercase tracking-wider"
                    >Compliance</span
                  >
                  <span class="text-white font-black">Active</span>
                </div>
              </div>
            </div>
            <div class="mt-12">
              <h3 class="text-white text-2xl font-bold">
                Resiliencia Corporativa
              </h3>
              <p class="text-blue-200/60 text-sm mt-2 leading-relaxed">
                Infraestructura blindada para el manejo de datos normativos y
                financieros de alto impacto.
              </p>
            </div>
          </div>
        </div>

        <!-- Right panel - Login form -->
        <div class="flex-1 p-8 lg:p-16 flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-10">
            <div class="size-8 text-primary">
              <svg
                fill="none"
                viewBox="0 0 48 48"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M24 45.8096C19.6865 45.8096 15.4698 44.5305 11.8832 42.134C8.29667 39.7376 5.50128 36.3314 3.85056 32.3462C2.19985 28.361 1.76794 23.9758 2.60947 19.7452C3.451 15.5145 5.52816 11.6284 8.57829 8.5783C11.6284 5.52817 15.5145 3.45101 19.7452 2.60948C23.9758 1.76795 28.361 2.19986 32.3462 3.85057C36.3314 5.50129 39.7376 8.29668 42.134 11.8833C44.5305 15.4698 45.8096 19.6865 45.8096 24L24 24L24 45.8096Z"
                  fill="currentColor"></path>
              </svg>
            </div>
            <h2
              class="text-primary dark:text-blue-400 text-xl font-black leading-tight tracking-tight"
            >
              MDA Analítica
            </h2>
          </div>

          <div class="mb-8">
            <h1
              class="text-3xl font-black text-slate-900 dark:text-white leading-tight"
            >
              Bienvenido al Portal Ejecutivo
            </h1>
            <p class="text-slate-500 dark:text-slate-400 mt-2">
              Inicie sesión para acceder a su panel de control y reportes
              normativos
            </p>
          </div>

          <form class="space-y-5">
            <div>
              <label
                class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2"
                >Correo electrónico corporativo</label
              >
              <input
                class="w-full h-12 px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none"
                placeholder="nombre@empresa.com"
                type="email"
              />
            </div>
            <div>
              <div class="flex justify-between mb-2">
                <label
                  class="text-sm font-semibold text-slate-700 dark:text-slate-300"
                  >Contraseña</label
                >
                <a
                  class="text-sm font-bold text-primary dark:text-blue-400 hover:underline"
                  href="/recuperar-password">¿Olvidó su contraseña?</a
                >
              </div>
              <div class="relative">
                <input
                  class="w-full h-12 px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent transition-all outline-none"
                  placeholder="••••••••"
                  type="password"
                  id="password-input"
                />
                <button
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
                  type="button"
                  id="toggle-password"
                >
                  <div id="eye-open">
                    <Eye size={20} />
                  </div>
                  <div id="eye-closed" class="hidden">
                    <EyeOff size={20} />
                  </div>
                </button>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <input
                class="w-4 h-4 rounded border-slate-300 text-primary focus:ring-primary"
                id="remember"
                type="checkbox"
              />
              <label
                class="text-sm text-slate-600 dark:text-slate-400"
                for="remember">Recordarme</label
              >
            </div>
            <button
              type="submit"
              class="w-full h-12 bg-primary hover:bg-blue-700 text-white font-black rounded-xl glow-button transition-all flex items-center justify-center gap-2"
            >
              <span>Iniciar Sesión</span>
            </button>
          </form>

          <div class="mt-8">
            <div class="relative flex items-center justify-center mb-6">
              <div
                class="border-t border-slate-200 dark:border-slate-700 w-full"
              >
              </div>
              <span
                class="absolute bg-white dark:bg-slate-900 px-4 text-xs font-bold text-slate-400 uppercase tracking-widest"
                >O continuar con</span
              >
            </div>
            <div class="grid grid-cols-2 gap-4">
              <button
                class="flex items-center justify-center gap-3 h-12 border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
              >
                <svg
                  class="size-5"
                  viewBox="0 0 23 23"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M11.4 24l-11.4-1.1v-14.2l11.4-1.1v16.4zm1.6-16.4l11-1.1v14.2l-11-1.1v-12z"
                    fill="#00a4ef"></path></svg
                >
                <span
                  class="text-sm font-bold text-slate-700 dark:text-slate-300"
                  >Microsoft</span
                >
              </button>
              <button
                class="flex items-center justify-center gap-3 h-12 border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
              >
                <svg class="size-5" viewBox="0 0 48 48"
                  ><path
                    d="M44.5 20H24v8.5h11.8C34.7 33.9 30.1 37 24 37c-7.2 0-13-5.8-13-13s5.8-13 13-13c3.1 0 5.9 1.1 8.1 2.9l6.4-6.4C34.6 4.1 29.6 2 24 2 11.8 2 24s9.8 22 22 22c11 0 21-8 21-22 0-1.3-.2-2.7-.5-4z"
                    fill="#4285F4"></path></svg
                >
                <span
                  class="text-sm font-bold text-slate-700 dark:text-slate-300"
                  >Google</span
                >
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer class="p-8">
      <div
        class="max-w-[1100px] mx-auto flex flex-col md:flex-row items-center justify-center gap-8 opacity-60"
      >
        <div class="flex items-center gap-3">
          <Gavel size={20} className="text-primary dark:text-blue-400" />
          <span
            class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
            >Cumplimiento GDPR & Ley 1581</span
          >
        </div>
        <div class="h-4 w-px bg-slate-300 dark:bg-slate-700 hidden md:block">
        </div>
        <div class="flex items-center gap-3">
          <ShieldCheck size={20} className="text-primary dark:text-blue-400" />
          <span
            class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
            >Seguridad de grado bancario (AES-256)</span
          >
        </div>
        <div class="h-4 w-px bg-slate-300 dark:bg-slate-700 hidden md:block">
        </div>
        <div class="flex items-center gap-3">
          <Lock size={20} className="text-primary dark:text-blue-400" />
          <span
            class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
            >SSL 256-bit Encryption</span
          >
        </div>
      </div>
      <div class="text-center mt-6">
        <p class="text-[10px] text-slate-400 font-medium">
          © 2024 MDA Analítica S.A.S. - Enterprise Compliance Systems
        </p>
      </div>
    </footer>

    <!-- AI Assistant Button -->
    <div class="fixed bottom-8 right-8 z-100 group flex flex-col items-end">
      <div
        class="mb-4 mr-2 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 pointer-events-none"
      >
        <div
          class="bg-slate-900 dark:bg-primary text-white text-xs font-bold py-2.5 px-4 rounded-xl shadow-2xl relative whitespace-nowrap"
        >
          ¿Dudas sobre SAGRILAFT? Pregúntame
          <div
            class="absolute bottom-[-6px] right-6 w-3 h-3 bg-slate-900 dark:bg-primary rotate-45"
          >
          </div>
        </div>
      </div>
      <button
        class="ai-glow relative flex items-center justify-center w-16 h-16 rounded-full bg-linear-to-br from-primary via-primary to-[#1e40af] dark:from-accent-green dark:to-[#065f46] text-white shadow-2xl transition-all duration-300 hover:scale-110 active:scale-95 border-2 border-white/20"
      >
        <Sparkles size={32} />
        <span class="absolute top-0 right-0 flex h-4 w-4">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-green opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-4 w-4 bg-emerald-400 border-2 border-white dark:border-slate-900"
          ></span>
        </span>
      </button>
    </div>

    <script>
      // Dark mode toggle
      const themeToggle = document.getElementById("theme-toggle");
      themeToggle?.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
        localStorage.setItem(
          "theme",
          document.documentElement.classList.contains("dark")
            ? "dark"
            : "light",
        );
      });

      // Check for saved theme preference
      if (
        localStorage.getItem("theme") === "dark" ||
        (!localStorage.getItem("theme") &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }

      // Toggle password visibility
      const togglePassword = document.getElementById("toggle-password");
      const passwordInput = document.getElementById(
        "password-input",
      ) as HTMLInputElement;
      const eyeOpen = document.getElementById("eye-open");
      const eyeClosed = document.getElementById("eye-closed");

      togglePassword?.addEventListener("click", () => {
        const isPassword = passwordInput?.type === "password";
        if (passwordInput)
          passwordInput.type = isPassword ? "text" : "password";

        if (isPassword) {
          eyeOpen?.classList.add("hidden");
          eyeClosed?.classList.remove("hidden");
        } else {
          eyeOpen?.classList.remove("hidden");
          eyeClosed?.classList.add("hidden");
        }
      });
    </script>
  </body>
</html>
