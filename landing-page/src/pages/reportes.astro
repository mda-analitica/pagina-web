    tag: 'Executive',
    tagColor: 'bg-primary',
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAwxuU0G7PAXbuvfkCmPy12fO-30uCFLCAY3x6_kyLV2tYSN1i9xgf9lFEPFy0fgihHMrfowsKx-OxsK6vXEqs3oEKSAauD0H-NrGcFXrnOwI068zjZC70GgRsujancmi_VBoAIQhJ9CkMlexH6WqG0mXcksZsbbEN29W__CdZV2vFlw5rE30dIFmtV07Ug2uXSgJEAniEdFSSXkdnUkbQ6hET0ojthqtrR7zCKqbYCScbMBFmJtcMO3aiCAbFmQoJE4Yj_eCEgnRIs',
