---
// Header component con navegación
import { Menu } from "lucide-react";
---

<header
  class="sticky top-0 z-50 glass-header border-b border-gray-200/60 px-6 md:px-10 py-4"
>
  <div
    class="max-w-[1280px] mx-auto flex items-center justify-between whitespace-nowrap"
  >
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <img
        src="https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/pc3/hsw/q5j/Logo%20MDA%20con%20Gemini.png"
        alt="MDA Analítica Logo"
        class="h-8 w-auto"
      />
      <h2
        class="text-xl font-black leading-tight tracking-tight bg-gradient-to-r from-primary to-accent-green bg-clip-text text-transparent"
      >
        MDA Analítica
      </h2>
    </div>

    <!-- Navigation -->
    <nav class="hidden lg:flex flex-1 justify-center gap-9">
      <a
        class="nav-link text-sm font-semibold leading-normal relative py-1"
        href="/#inicio">Inicio</a
      >
      <a
        class="nav-link text-sm font-semibold leading-normal relative py-1"
        href="#soluciones">Soluciones</a
      >
      <a
        class="nav-link text-sm font-semibold leading-normal relative py-1"
        href="#analitica">Analítica</a
      >
      <a
        class="nav-link text-sm font-semibold leading-normal relative py-1"
        href="#nosotros">Nosotros</a
      >
    </nav>

    <!-- Actions -->
    <div class="flex gap-3 items-center">
      <button
        onclick="document.getElementById('rif-modal').classList.remove('hidden')"
        class="flex min-w-[160px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-6 bg-accent-green text-white text-sm font-bold leading-normal tracking-wide transition-all duration-300 hover:bg-emerald-600 border border-emerald-400/20 glow-accent"
      >
        <span>Ir a RIF-Analytic</span>
      </button>
    </div>

    <!-- Mobile menu button -->
    <button
      class="lg:hidden flex items-center justify-center rounded-lg h-10 w-10 text-gray-600"
      id="mobile-menu-btn"
    >
      <Menu size={24} />
    </button>
  </div>
</header>

<style>
  .nav-link {
    color: #4b5563;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #007878;
  }

  .nav-link.active-link {
    color: #007878;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #007878;
    transition: width 0.3s ease-in-out;
  }

  .nav-link.active-link::after {
    width: 100%;
  }
</style>

<script>
  // Active Link Scroll Spy Logic
  document.addEventListener("DOMContentLoaded", () => {
    const sections = ["inicio", "soluciones", "analitica", "blog", "nosotros"];
    const navLinks = document.querySelectorAll(".nav-link");

    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => link.classList.remove("active-link"));

          const activeId = entry.target.id;
          const activeLink = document.querySelector(
            `.nav-link[href*="#${activeId}"]`,
          );
          if (activeLink) {
            activeLink.classList.add("active-link");
          }
        }
      });
    }, observerOptions);

    sections.forEach((id) => {
      const section = document.getElementById(id);
      if (section) {
        observer.observe(section);
      }
    });
  });
</script>
