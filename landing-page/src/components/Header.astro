---
// Header component con navegación, dropdown de aplicaciones y menú móvil
import { Menu, X, PieChart, ChevronDown, Home, LayoutGrid, BarChart3, Users } from "lucide-react";

const navLinks = [
  { href: "/#inicio", label: "Inicio", icon: Home },
  { href: "/#soluciones", label: "Soluciones", icon: LayoutGrid },
  { href: "/#analitica", label: "Analítica", icon: BarChart3 },
  { href: "/#nosotros", label: "Nosotros", icon: Users },
];
---

<header
  class="sticky top-0 z-50 glass-header border-b border-solid border-[#e7eaf3] dark:border-gray-800 px-6 md:px-10 py-3"
>
  <div
    class="max-w-[1280px] mx-auto flex items-center justify-between whitespace-nowrap"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
      <div class="size-8 text-primary">
        <PieChart size={32} />
      </div>
      <h2
        class="text-primary dark:text-teal-400 text-xl font-black leading-tight tracking-tight"
      >
        MDA Analítica
      </h2>
    </a>

    <!-- Navigation -->
    <nav class="hidden lg:flex flex-1 justify-center gap-9">
      {navLinks.map((link) => (
        <a
          class="nav-link text-sm font-semibold leading-normal relative py-1"
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Actions (desktop) -->
    <div class="hidden lg:flex gap-3 items-center">
      <div class="relative" id="apps-dropdown">
        <button
          id="apps-dropdown-btn"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="apps-dropdown-menu"
          class="flex min-w-[160px] cursor-pointer items-center justify-center gap-1 overflow-hidden rounded-lg h-10 px-6 bg-accent-green text-white text-sm font-bold leading-normal tracking-wide transition-all hover:bg-emerald-600 border border-emerald-400/20 glow-accent"
        >
          <span>Ver Aplicaciones</span>
          <ChevronDown size={16} className="transition-transform duration-200" />
        </button>
        <!-- Dropdown Menu -->
        <div
          id="apps-dropdown-menu"
          class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-lg shadow-lg hidden py-2 z-50 flex-col"
        >
          <button
            class="rif-app-btn w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors cursor-pointer"
          >
            RIF-Analytic
          </button>
          <a
            href="/sagrilaft"
            class="block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
          >
            SAGRILAFT
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile menu button -->
    <button
      class="lg:hidden flex items-center justify-center rounded-lg h-10 w-10 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
      id="mobile-menu-btn"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu size={24} />
    </button>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu-overlay"
  class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
</div>

<!-- Mobile Menu Panel -->
<nav
  id="mobile-menu"
  class="fixed top-0 right-0 h-full w-[300px] max-w-[85vw] bg-white dark:bg-background-dark shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-out lg:hidden"
  aria-label="Menú móvil"
>
  <div class="flex flex-col h-full">
    <!-- Header del panel -->
    <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-3">
        <div class="size-6 text-primary">
          <PieChart size={24} />
        </div>
        <span class="text-primary dark:text-teal-400 text-lg font-bold">Menú</span>
      </div>
      <button
        id="mobile-menu-close"
        class="flex items-center justify-center rounded-lg h-10 w-10 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Cerrar menú"
      >
        <X size={24} />
      </button>
    </div>

    <!-- Links de navegación -->
    <div class="flex-1 overflow-y-auto py-6">
      <ul class="space-y-2 px-4">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-base font-semibold transition-colors text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800"
            >
              <link.icon size={20} className="text-primary shrink-0" />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Aplicaciones -->
    <div class="p-6 border-t border-gray-200 dark:border-gray-800 space-y-3">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-400">Aplicaciones</p>
      <button
        class="rif-app-btn flex w-full cursor-pointer items-center justify-center rounded-xl h-12 px-6 bg-accent-green text-white text-sm font-bold leading-normal tracking-wide transition-all hover:bg-emerald-600 border border-emerald-400/20"
      >
        RIF-Analytic
      </button>
      <a
        href="/sagrilaft"
        class="flex w-full cursor-pointer items-center justify-center rounded-xl h-12 px-6 border-2 border-primary/30 text-primary dark:text-teal-400 dark:border-teal-400/30 text-sm font-bold leading-normal transition-all hover:bg-primary/5"
      >
        SAGRILAFT
      </a>
    </div>
  </div>
</nav>

<style>
  /* Base style for link text */
  .nav-link {
    color: #4b5563; /* gray-600 */
    transition: color 0.3s ease;
  }

  :global(.dark) .nav-link {
    color: #9ca3af; /* gray-400 */
  }

  .nav-link:hover {
    color: #007878; /* primary approx */
  }

  :global(.dark) .nav-link:hover {
    color: #2dd4bf; /* teal-400 approx */
  }

  /* Active state text color */
  .nav-link.active-link {
    color: #007878; /* primary */
  }

  :global(.dark) .nav-link.active-link {
    color: #2dd4bf; /* teal-400 */
  }

  /* Underline animation using pseudo-element */
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px; /* Adjust distance from text */
    left: 0;
    width: 0;
    height: 2px;
    background-color: #007878; /* primary */
    transition: width 0.3s ease-in-out;
  }

  :global(.dark) .nav-link::after {
    background-color: #2dd4bf; /* teal-400 */
  }

  /* Show underline on active or hover if desired, usually just active for 'traveling' */
  .nav-link.active-link::after {
    width: 100%;
  }
</style>

<script>
  // --- Dropdown "Ver Aplicaciones" (click, compatible con táctil) ---
  const dropdownBtn = document.getElementById("apps-dropdown-btn");
  const dropdownMenu = document.getElementById("apps-dropdown-menu");

  function closeDropdown() {
    dropdownMenu?.classList.add("hidden");
    dropdownBtn?.setAttribute("aria-expanded", "false");
  }

  dropdownBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = !dropdownMenu?.classList.contains("hidden");
    if (isOpen) {
      closeDropdown();
    } else {
      dropdownMenu?.classList.remove("hidden");
      dropdownBtn.setAttribute("aria-expanded", "true");
    }
  });

  document.addEventListener("click", (e) => {
    if (!document.getElementById("apps-dropdown")?.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // --- Botones RIF-Analytic: abre el modal si existe en la página, si no navega ---
  document.querySelectorAll(".rif-app-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const rifModal = document.getElementById("rif-modal");
      if (rifModal) {
        closeDropdown();
        closeMobileMenu();
        rifModal.classList.remove("hidden");
      } else {
        window.location.href = "/#analitica";
      }
    });
  });

  // --- Menú móvil ---
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenuClose = document.getElementById("mobile-menu-close");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");

  let isMenuOpen = false;

  function openMobileMenu() {
    if (!mobileMenu || !mobileMenuOverlay || !mobileMenuBtn) return;
    isMenuOpen = true;
    mobileMenu.classList.remove("translate-x-full");
    mobileMenuOverlay.classList.remove("opacity-0", "pointer-events-none");
    mobileMenuBtn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    (mobileMenuClose as HTMLElement | null)?.focus();
  }

  function closeMobileMenu() {
    if (!mobileMenu || !mobileMenuOverlay || !mobileMenuBtn || !isMenuOpen) return;
    isMenuOpen = false;
    mobileMenu.classList.add("translate-x-full");
    mobileMenuOverlay.classList.add("opacity-0", "pointer-events-none");
    mobileMenuBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    mobileMenuBtn.focus();
  }

  mobileMenuBtn?.addEventListener("click", openMobileMenu);
  mobileMenuClose?.addEventListener("click", closeMobileMenu);
  mobileMenuOverlay?.addEventListener("click", closeMobileMenu);

  // Cerrar el menú al navegar con un link
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMobileMenu());
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMobileMenu();
      closeDropdown();
    }
  });

  // --- Scroll Spy: resalta el link activo según la sección visible ---
  document.addEventListener("DOMContentLoaded", () => {
    const sections = ["inicio", "soluciones", "analitica", "blog", "nosotros"];
    const navLinks = document.querySelectorAll(".nav-link");

    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.3, // Trigger when 30% of section is visible
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Remove active class from all links
          navLinks.forEach((link) => link.classList.remove("active-link"));

          // Add active class to corresponding link
          const activeId = entry.target.id;
          const activeLink = document.querySelector(
            `.nav-link[href*="#${activeId}"]`,
          );
          if (activeLink) {
            activeLink.classList.add("active-link");
          }
        }
      });
    }, observerOptions);

    sections.forEach((id) => {
      const section = document.getElementById(id);
      if (section) {
        observer.observe(section);
      }
    });
  });
</script>
