---
// Newsletter Section - MDA Briefing subscription
---

<section class="py-16 bg-pearl dark:bg-gray-900/50">
    <div class="max-w-[1280px] mx-auto px-6 md:px-10">
        <div
            class="bg-[#0e111b] rounded-2xl p-8 lg:p-12 flex flex-col lg:flex-row items-center gap-10 overflow-hidden relative"
        >
            <!-- Decorative blurs -->
            <div
                class="absolute top-0 right-0 w-64 h-64 bg-primary/10 rounded-full blur-[100px] -mr-32 -mt-32"
            >
            </div>
            <div
                class="absolute bottom-0 left-0 w-48 h-48 bg-accent-blue/20 rounded-full blur-[80px] -ml-24 -mb-24"
            >
            </div>

            <!-- Content -->
            <div class="flex-1 text-center lg:text-left z-10">
                <h2 class="text-white text-2xl lg:text-3xl font-bold mb-3">
                    Únase al MDA Briefing
                </h2>
                <p class="text-gray-400 text-base lg:text-lg font-medium">
                    Análisis técnicos semanales para <span
                        class="text-white font-bold">+5,000</span
                    > profesionales del sector.
                </p>
            </div>

            <!-- Form -->
            <div class="flex-1 w-full max-w-md z-10">
                <form class="flex flex-col sm:flex-row gap-3">
                    <input
                        type="email"
                        placeholder="Su correo profesional"
                        class="flex-1 h-12 rounded-lg bg-white/10 border border-white/20 text-white placeholder:text-gray-500 focus:ring-2 focus:ring-primary focus:border-primary px-4 outline-none transition-all"
                    />
                    <button
                        type="submit"
                        class="h-12 px-8 bg-primary text-white font-bold rounded-lg hover:shadow-lg hover:shadow-primary/30 hover:scale-105 transition-all whitespace-nowrap"
                    >
                        Suscribirme
                    </button>
                </form>
                <p
                    class="text-gray-600 text-[10px] mt-3 text-center lg:text-left italic"
                >
                    Prometemos no enviar spam. Puede cancelar en cualquier
                    momento.
                </p>
            </div>
        </div>
    </div>
</section>
