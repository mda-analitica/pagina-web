---
// Hero section component
import { BarChart3 } from "lucide-react";

interface Props {
  tagline?: string;
  title?: string;
  highlightedText?: string;
  description?: string;
  primaryCta?: string;
  secondaryCta?: string;
  imageUrl?: string;
}

const {
  tagline = "Analytics Excellence",
  title = "Cumplimiento Normativo y Analítica Financiera de",
  highlightedText = "Nueva Generación",
  description = "Especialistas en gestión de riesgos SARLAFT, SAGRILAFT y PTEE con analítica de avanzada para la toma de decisiones ejecutivas en tiempo real.",
  primaryCta = "Probar Demo en Vivo",
  secondaryCta = "Ver Servicios",
  imageUrl = "https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/8sm/xkp/fl4/Balance%20General%20Nivel%201.png",
} = Astro.props;

const images = [
  "https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/8sm/xkp/fl4/Balance%20General%20Nivel%201.png",
  "https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/jx5/y15/lye/Balance%20General%20Nivel%203.png",
];
---

<section
  id="inicio"
  class="relative overflow-hidden bg-white dark:bg-background-dark py-16 lg:py-24"
>
  <div class="max-w-[1280px] mx-auto px-6 md:px-10">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <!-- Content -->
      <div class="flex flex-col gap-8 flex-1">
        <div class="flex flex-col gap-4 text-left">
          <span
            class="text-primary dark:text-blue-400 text-sm font-extrabold uppercase tracking-widest"
          >
            {tagline}
          </span>
          <h1
            class="text-[#0e111b] dark:text-white text-4xl lg:text-6xl font-black leading-[1.1] tracking-tight"
          >
            {title}
            <span class="text-primary dark:text-blue-400"
              >{highlightedText}</span
            >
          </h1>
          <p
            class="text-gray-600 dark:text-gray-400 text-lg md:text-xl font-normal leading-relaxed max-w-xl"
          >
            {description}
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/login"
            class="glow-button flex min-w-[240px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-14 px-8 bg-primary text-white text-base font-bold leading-normal tracking-wide border border-blue-400/20"
          >
            <BarChart3 className="mr-2" size={20} />
            <span>{primaryCta}</span>
          </a>
          <button
            class="flex min-w-[180px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-14 px-8 border-2 border-primary/20 bg-transparent text-primary dark:text-blue-400 dark:border-blue-400/20 text-base font-bold leading-normal hover:bg-primary/5"
          >
            {secondaryCta}
          </button>
        </div>
      </div>

      <!-- Dynamic Image Slider -->
      <div class="flex-1 w-full relative">
        <div
          id="hero-slider"
          class="relative z-10 w-full aspect-video rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900"
        >
          {
            images.map((img, index) => (
              <img
                src={img}
                alt={`Balance General MDA Analítica ${index + 1}`}
                class={`hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out ${index === 0 ? "opacity-100" : "opacity-0"}`}
                data-index={index}
              />
            ))
          }
        </div>
        <!-- Decorative blurs -->
        <div
          class="absolute -top-6 -right-6 w-32 h-32 bg-accent-green/10 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute -bottom-10 -left-10 w-48 h-48 bg-primary/10 rounded-full blur-3xl"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupSlider() {
    const slides = document.querySelectorAll(".hero-slide");
    if (slides.length === 0) return;

    let currentIndex = 0;

    function nextSlide() {
      // Hide current
      slides[currentIndex].classList.remove("opacity-100");
      slides[currentIndex].classList.add("opacity-0");

      // Move to next
      currentIndex = (currentIndex + 1) % slides.length;

      // Show next
      slides[currentIndex].classList.remove("opacity-0");
      slides[currentIndex].classList.add("opacity-100");
    }

    // Change every 4 seconds
    setInterval(nextSlide, 4000);
  }

  // Run on first load
  setupSlider();

  // Re-run if Astro swaps content (for View Transitions)
  document.addEventListener("astro:after-swap", setupSlider);
</script>
