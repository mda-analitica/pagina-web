---
// Intelligence Hub section - Power BI reports gallery
import { Presentation, ArrowRight, X } from "lucide-react";

const reports = [
  {
    title: "RIF Analítica",
    description: "Minería de datos financiero",
    tag: "",
    tagColor: "bg-primary",
    image:
      "https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/8sm/xkp/fl4/Balance%20General%20Nivel%201.png",
    hasModal: true,
    modalId: "rif-modal",
    modalType: "powerbi",
  },
  {
    title: "Riesgo de cartera",
    description: "Analítica del riesgo y de la mora",
    tag: "Próximamente",
    tagColor: "bg-gray-800",
    image:
      "https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/qxp/2yh/y20/Morosidad%20Cooperativas.png",
    hasModal: true,
    modalId: "riesgo-modal",
    modalType: "image",
  },
  {
    title: "Benchmarking sector solidario",
    description: "Análisis del sector solidario con 77 indicadores.",
    tag: "Próximamente",
    tagColor: "bg-gray-800",
    image:
      "https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/9x0/g91/363/Benchmarking.png",
    hasModal: true,
    modalId: "benchmarking-modal",
    modalType: "image",
  },
];
---

<section id="analitica" class="py-20 lg:py-28 bg-white">
  <div class="max-w-[1280px] mx-auto px-6 md:px-10">
    <!-- Section header -->
    <div class="flex flex-col gap-4 mb-12">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div
            class="w-10 h-10 bg-yellow-400 rounded-xl flex items-center justify-center text-white"
          >
            <Presentation size={24} />
          </div>
          <h2 class="text-3xl lg:text-4xl font-extrabold tracking-tight text-[#0e111b]">
            Analítica de Datos
          </h2>
        </div>
        <a
          class="text-primary font-bold text-sm flex items-center gap-1 hover:underline"
          href="/reportes"
        >
          Ver todos los reportes <ArrowRight size={16} />
        </a>
      </div>
      <div class="w-20 h-1 bg-gradient-to-r from-primary to-accent-green rounded-full"></div>
    </div>

    <!-- Reports grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        reports.map((report) => (
          <div
            class="group relative overflow-hidden rounded-2xl bg-gray-100 aspect-video shadow-sm hover:shadow-lg hover:shadow-primary/5 border border-gray-200/50 hover:border-primary/20 transition-all cursor-pointer"
            onclick={report.hasModal ? `document.getElementById('${report.modalId}').classList.remove('hidden')` : ""}
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105"
              style={`background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.15), rgba(0,0,0,0.7)), url('${report.image}')`}
            />
            {report.tag && (
              <div
                class={`absolute top-4 left-4 ${report.tagColor} text-white text-[10px] font-semibold px-3 py-1 rounded-full uppercase backdrop-blur-sm opacity-70`}
              >
                {report.tag}
              </div>
            )}
            <div class="absolute bottom-6 left-6 right-6">
              <p class="text-white text-xl font-bold leading-tight drop-shadow-md">
                {report.title}
              </p>
              <p class="text-white/80 text-sm mt-1 drop-shadow-md">{report.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- RIF Analítica Modal -->
<div id="rif-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-[95vw] h-[95vh] overflow-auto relative">
    <!-- Close button -->
    <button
      class="absolute top-4 right-4 z-10 p-2 hover:bg-gray-100 rounded-xl text-gray-500 hover:text-gray-700 transition-colors"
      onclick="document.getElementById('rif-modal').classList.add('hidden')"
    >
      <X size={24} />
    </button>

    <!-- iframe -->
    <div class="w-full h-full flex items-center justify-center p-0">
      <iframe
        title="RIF-Analytic(2)"
        width="100%"
        height="100%"
        src="https://app.powerbi.com/view?r=eyJrIjoiOTI4MDIwOGQtZjJkZC00ZmZhLWEwZmEtY2FjNjA4MzMwYTNkIiwidCI6IjFkY2Y4YjdlLTAzZTItNDU2ZC05Y2JkLTEyMTNiNjg1ZjU0MyJ9&embedImagePlaceholder=true"
        frameborder="0"
        allowfullscreen="true"
      >
      </iframe>
    </div>
  </div>
</div>

<!-- Riesgo de Cartera Modal -->
<div id="riesgo-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-[95vw] h-[95vh] overflow-auto relative">
    <!-- Close button -->
    <button
      class="absolute top-4 right-4 z-10 p-2 hover:bg-gray-100 rounded-xl text-gray-500 hover:text-gray-700 transition-colors"
      onclick="document.getElementById('riesgo-modal').classList.add('hidden')"
    >
      <X size={24} />
    </button>

    <!-- Próximamente badge -->
    <div class="absolute top-4 left-4 z-10 bg-gray-800 text-white text-[10px] font-semibold px-3 py-1 rounded-full uppercase opacity-70">
      Próximamente
    </div>

    <!-- Image -->
    <div class="w-full h-full flex items-center justify-center p-0">
      <img
        src="https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/qxp/2yh/y20/Morosidad%20Cooperativas.png"
        alt="Riesgo de cartera"
        class="w-full h-full object-contain"
      />
    </div>
  </div>
</div>

<!-- Benchmarking Sector Solidario Modal -->
<div id="benchmarking-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-[95vw] h-[95vh] overflow-auto relative">
    <!-- Close button -->
    <button
      class="absolute top-4 right-4 z-10 p-2 hover:bg-gray-100 rounded-xl text-gray-500 hover:text-gray-700 transition-colors"
      onclick="document.getElementById('benchmarking-modal').classList.add('hidden')"
    >
      <X size={24} />
    </button>

    <!-- Próximamente badge -->
    <div class="absolute top-4 left-4 z-10 bg-gray-800 text-white text-[10px] font-semibold px-3 py-1 rounded-full uppercase opacity-70">
      Próximamente
    </div>

    <!-- Image -->
    <div class="w-full h-full flex items-center justify-center p-0">
      <img
        src="https://f158ae34df.imgdist.com/pub/bfra/i6q4k2r4/9x0/g91/363/Benchmarking.png"
        alt="Benchmarking sector solidario"
        class="w-full h-full object-contain"
      />
    </div>
  </div>
</div>

<script>
  // Close modals when clicking backdrop
  ['rif-modal', 'riesgo-modal', 'benchmarking-modal'].forEach(modalId => {
    document.getElementById(modalId)?.addEventListener('click', (e) => {
      if (e.target.id === modalId) {
        document.getElementById(modalId).classList.add('hidden');
      }
    });
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      ['rif-modal', 'riesgo-modal', 'benchmarking-modal'].forEach(modalId => {
        const modal = document.getElementById(modalId);
        if (modal && !modal.classList.contains('hidden')) {
          modal.classList.add('hidden');
        }
      });
    }
  });
</script>
