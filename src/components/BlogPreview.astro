<section id="blog" class="bg-pearl dark:bg-[#0b0e14] py-20 px-6 md:px-10">
  <div class="max-w-[1280px] mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
      <div>
        <span class="text-primary text-xs font-bold uppercase tracking-widest mb-3 block">Insights & Perspectivas</span>
        <h2 class="text-[#0e111b] dark:text-white text-4xl md:text-5xl font-black leading-tight tracking-tight">
          Blog <span class="text-primary">Normativo</span>
        </h2>
        <p class="text-gray-500 dark:text-gray-400 text-lg mt-4 max-w-xl">
          Análisis profundo y actualizaciones críticas sobre SARLAFT, SAGRILAFT y analítica financiera avanzada.
        </p>
      </div>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-primary hover:text-teal-700 dark:hover:text-teal-300 font-bold text-sm transition-colors group"
      >
        Ver todos los artículos
        <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
      </a>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredPosts.map((post, index) => (
        <article
          class={`group relative bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1 ${
            index === 0 ? 'md:col-span-2 md:row-span-2' : ''
          }`}
        >
          {/* Image */}
          <div
            class={`bg-cover bg-center ${index === 0 ? 'h-64 md:h-full md:absolute md:inset-0' : 'h-40'}`}
            style={`background-image: url('${post.image}')`}
          >
            {index === 0 && (
              <div class="absolute inset-0 bg-gradient-to-t from-[#0e111b]/90 via-[#0e111b]/40 to-transparent"></div>
            )}
          </div>

          {/* Content */}
          <div class={`p-5 flex flex-col ${index === 0 ? 'md:absolute md:bottom-0 md:left-0 md:right-0 md:p-8' : ''}`}>
            <div class="flex items-center gap-3 mb-3">
              <span class={`text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider ${
                index === 0
                  ? 'bg-primary text-white'
                  : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'
              }`}>
                {post.category}
              </span>
              <span class={`text-[10px] font-medium flex items-center gap-1 ${
                index === 0 ? 'text-gray-300' : 'text-gray-500'
              }`}>
                <span class="material-symbols-outlined text-[12px]">schedule</span>
                {post.readTime}
              </span>
            </div>

            <h3 class={`font-bold leading-snug mb-2 group-hover:text-primary transition-colors ${
              index === 0
                ? 'text-white text-xl md:text-2xl'
                : 'text-[#0e111b] dark:text-white text-base'
            }`}>
              {post.title}
            </h3>

            <p class={`text-sm leading-relaxed line-clamp-2 ${
              index === 0
                ? 'text-gray-300 md:line-clamp-3'
                : 'text-gray-600 dark:text-gray-400'
            }`}>
              {post.description}
            </p>

            <div class={`flex items-center justify-between mt-4 pt-3 border-t ${
              index === 0
                ? 'border-gray-700'
                : 'border-gray-100 dark:border-gray-800'
            }`}>
              <span class={`text-xs ${index === 0 ? 'text-gray-400' : 'text-gray-500'}`}>
                {post.date}
              </span>
              <a
                href="/blog"
                class={`text-sm font-bold flex items-center gap-1 transition-colors ${
                  index === 0
                    ? 'text-white hover:text-primary'
                    : 'text-[#0e111b] dark:text-white hover:text-primary'
                }`}
              >
                Leer
                <span class="material-symbols-outlined text-lg">chevron_right</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Newsletter CTA -->
    <div class="mt-12 bg-gradient-to-r from-[#0e111b] to-gray-900 rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center gap-6 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary/10 rounded-full blur-[100px] -mr-32 -mt-32"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent-green/20 rounded-full blur-[80px] -ml-24 -mb-24"></div>

      <div class="flex-1 text-center md:text-left z-10">
        <h3 class="text-white text-xl md:text-2xl font-bold mb-2">Únase al MDA Briefing</h3>
        <p class="text-gray-400 text-sm">Análisis técnicos semanales para +5,000 profesionales del sector.</p>
      </div>

      <form class="flex gap-3 z-10 w-full md:w-auto">
        <input
          type="email"
          placeholder="Su correo profesional"
          class="flex-1 md:w-64 h-12 px-4 rounded-lg bg-white/10 border border-white/20 text-white placeholder:text-gray-500 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
        />
        <button
          type="submit"
          class="h-12 px-6 bg-accent-green text-white font-bold rounded-lg hover:bg-emerald-600 hover:shadow-lg hover:shadow-accent-green/30 transition-all whitespace-nowrap"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
