---
// Verticales section - Services tabs
const tabs = [
  { id: 'cumplimiento', icon: 'verified_user', label: 'Cumplimiento (Core)', active: true },
  { id: 'rif', icon: 'query_stats', label: 'RIF - Analítica Financiera', active: false },
  { id: 'desarrollo', icon: 'code_blocks', label: 'Desarrollo & Consultoría', active: false },
];

const tabContent = {
  cumplimiento: {
    title: 'Expertos en Regulación Local',
    description: 'Nuestras soluciones están diseñadas para cumplir con los estándares más estrictos de la Superintendencia Financiera y de Sociedades. Automatice sus procesos de debida diligencia y monitoreo transaccional.',
    features: [
      'Monitoreo SARLAFT 4.0',
      'Gestión de Listas Restrictivas (AML)',
      'Segmentación de Factores de Riesgo',
    ],
    stats: [
      { value: '99%', label: 'Exactitud Técnica' },
      { value: '50+', label: 'Clientes Core' },
    ],
  },
  rif: {
    title: 'Inteligencia Financiera Avanzada',
    description: 'Transforme sus datos financieros en insights accionables. Nuestra plataforma RIF integra análisis predictivo, detección de anomalías y reportería automatizada para una gestión de riesgos proactiva.',
    features: [
      'Dashboards ejecutivos en tiempo real',
      'Análisis predictivo de cartera',
      'Detección automática de fraudes',
      'Reportes ROS automatizados',
    ],
    stats: [
      { value: '85%', label: 'Reducción tiempo análisis' },
      { value: '200+', label: 'Reportes generados/mes' },
    ],
  },
  desarrollo: {
    title: 'Soluciones a la Medida',
    description: 'Nuestro equipo de expertos desarrolla soluciones personalizadas que se adaptan a las necesidades específicas de su organización. Desde integraciones API hasta sistemas completos de gestión de riesgos.',
    features: [
      'Desarrollo de APIs e integraciones',
      'Consultoría técnica especializada',
      'Capacitación y transferencia de conocimiento',
      'Soporte técnico dedicado 24/7',
    ],
    stats: [
      { value: '30+', label: 'Proyectos entregados' },
      { value: '100%', label: 'Satisfacción cliente' },
    ],
  },
};
---

<section id="solutions" class="bg-pearl dark:bg-gray-900/50 py-16">
  <div class="max-w-[1280px] mx-auto px-6 md:px-10">
    <!-- Section header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-[#0e111b] dark:text-white">Nuestras Verticales</h2>
      <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- Tabs -->
    <div
      class="flex flex-wrap border-b border-gray-200 dark:border-gray-800 gap-4 md:gap-12 justify-center"
      role="tablist"
      aria-label="Verticales de servicio"
    >
      {tabs.map((tab, index) => (
        <button
          data-tab={tab.id}
          role="tab"
          aria-selected={tab.active ? 'true' : 'false'}
          aria-controls={`panel-${tab.id}`}
          id={`tab-${tab.id}`}
          tabindex={tab.active ? 0 : -1}
          class={`tab-btn flex flex-col items-center justify-center border-b-4 pb-4 pt-2 transition-all duration-300 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ${
            tab.active
              ? 'border-primary text-primary'
              : 'border-transparent text-gray-500 hover:text-primary'
          }`}
        >
          <span class="material-symbols-outlined mb-2" aria-hidden="true">{tab.icon}</span>
          <p class="text-sm font-bold uppercase tracking-wider">{tab.label}</p>
        </button>
      ))}
    </div>

    <!-- Content Panels -->
    {Object.entries(tabContent).map(([id, content]) => (
      <div
        id={`panel-${id}`}
        role="tabpanel"
        aria-labelledby={`tab-${id}`}
        tabindex="0"
        class={`tab-panel mt-10 grid md:grid-cols-2 gap-12 items-center bg-white dark:bg-gray-800 p-8 lg:p-12 rounded-2xl shadow-sm transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary ${
          id === 'cumplimiento' ? '' : 'hidden'
        }`}
      >
        <div>
          <h3 class="text-2xl font-bold mb-4 dark:text-white">{content.title}</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
            {content.description}
          </p>
          <ul class="space-y-3">
            {content.features.map((feature) => (
              <li class="flex items-center gap-3 text-sm font-semibold text-gray-700 dark:text-gray-300">
                <span class="material-symbols-outlined text-accent-green">check_circle</span>
                {feature}
              </li>
            ))}
          </ul>
        </div>

        <!-- Stats grid -->
        <div class="grid grid-cols-2 gap-4">
          {content.stats.map((stat) => (
            <div class="p-6 bg-pearl dark:bg-gray-700 rounded-xl">
              <h4 class="text-primary dark:text-teal-400 text-3xl font-black mb-1">{stat.value}</h4>
              <p class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // Tab functionality with keyboard navigation
  const tabButtons = document.querySelectorAll('.tab-btn') as NodeListOf<HTMLButtonElement>;
  const tabPanels = document.querySelectorAll('.tab-panel');

  function activateTab(tab: HTMLButtonElement) {
    const tabId = tab.getAttribute('data-tab');

    // Update button states and ARIA attributes
    tabButtons.forEach(b => {
      b.classList.remove('border-primary', 'text-primary');
      b.classList.add('border-transparent', 'text-gray-500');
      b.setAttribute('aria-selected', 'false');
      b.setAttribute('tabindex', '-1');
    });
    tab.classList.remove('border-transparent', 'text-gray-500');
    tab.classList.add('border-primary', 'text-primary');
    tab.setAttribute('aria-selected', 'true');
    tab.setAttribute('tabindex', '0');
    tab.focus();

    // Update panel visibility
    tabPanels.forEach(panel => {
      panel.classList.add('hidden');
    });
    const activePanel = document.getElementById(`panel-${tabId}`);
    if (activePanel) {
      activePanel.classList.remove('hidden');
    }
  }

  tabButtons.forEach((btn, index) => {
    // Click handler
    btn.addEventListener('click', () => activateTab(btn));

    // Keyboard navigation
    btn.addEventListener('keydown', (e) => {
      let targetIndex = index;

      switch (e.key) {
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          targetIndex = index === 0 ? tabButtons.length - 1 : index - 1;
          break;
        case 'ArrowRight':
        case 'ArrowDown':
          e.preventDefault();
          targetIndex = index === tabButtons.length - 1 ? 0 : index + 1;
          break;
        case 'Home':
          e.preventDefault();
          targetIndex = 0;
          break;
        case 'End':
          e.preventDefault();
          targetIndex = tabButtons.length - 1;
          break;
        default:
          return;
      }

      activateTab(tabButtons[targetIndex]);
    });
  });
</script>
