---
// Footer component
const solutions = [
  { label: 'Monitoreo SARLAFT', href: '/#solutions' },
  { label: 'Gestión PTEE', href: '/#solutions' },
  { label: 'Tableros Power BI', href: '/#analytics' },
  { label: 'Auditoría Técnica', href: '/#solutions' },
];

const company = [
  { label: 'Sobre Nosotros', href: '/#company' },
  { label: 'Nuestra Metodología', href: '/#solutions' },
  { label: 'Intelligence Hub', href: '/#analytics' },
  { label: 'Blog Normativo', href: '/#blog' },
  { label: 'Contacto', href: '/#company' },
];

const contact = [
  { icon: 'location_on', text: 'Medellín, Antioquia, Belén Rincón' },
  { icon: 'mail', text: 'contacto@mda-analitica.com', href: 'mailto:contacto@mda-analitica.com' },
  { icon: 'phone', text: '+57 (301) 215-9933', href: 'tel:+573012159933' },
];

const legal = [
  { label: 'Términos y Condiciones', href: '/terminos' },
  { label: 'Política de Privacidad', href: '/privacidad' },
  { label: 'Cookies', href: '/cookies' },
];

const socialLinks = [
  { icon: 'public', href: 'https://www.mda-analitica.com', label: 'Sitio web' },
  { icon: 'alternate_email', href: 'mailto:contacto@mda-analitica.com', label: 'Email' },
];
---

<footer id="company" class="bg-white dark:bg-background-dark border-t border-gray-200 dark:border-gray-800 py-16">
  <div class="max-w-[1280px] mx-auto px-6 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="col-span-1 lg:col-span-1">
        <div class="flex items-center gap-3 mb-6">
          <img
            src="https://media.licdn.com/dms/image/v2/D4D0BAQFBTb4ytPgBqg/company-logo_200_200/company-logo_200_200/0/1734536293594/soli_data_logo?e=2147483647&v=beta&t=u1oNzOV0yDffdp9DSRG7Ga_wkfTgM4KBAuSzIUtaNXc"
            alt="Soli Data Logo"
            class="size-6 rounded object-contain"
          />
          <h2 class="text-primary dark:text-teal-400 text-lg font-bold">MDA Analítica</h2>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed mb-6">
          Líderes en analítica avanzada y consultoría de cumplimiento normativo para el sector financiero y real.
        </p>
        <div class="flex gap-4">
          {socialLinks.map((link) => (
            <a
              class="w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:bg-primary hover:text-white transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
              href={link.href}
              aria-label={link.label}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <span class="material-symbols-outlined">{link.icon}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Solutions -->
      <div>
        <h4 class="font-bold text-[#0e111b] dark:text-white mb-6 uppercase text-xs tracking-widest">Soluciones</h4>
        <ul class="space-y-4">
          {solutions.map((item) => (
            <li>
              <a
                class="footer-link text-gray-500 hover:text-primary transition-colors duration-300 text-sm focus:outline-none focus:text-primary"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-bold text-[#0e111b] dark:text-white mb-6 uppercase text-xs tracking-widest">Compañía</h4>
        <ul class="space-y-4">
          {company.map((item) => (
            <li>
              <a
                class="footer-link text-gray-500 hover:text-primary transition-colors duration-300 text-sm focus:outline-none focus:text-primary"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-bold text-[#0e111b] dark:text-white mb-6 uppercase text-xs tracking-widest">Contacto Formal</h4>
        <ul class="space-y-4">
          {contact.map((item) => (
            <li class="flex items-center gap-3 text-sm text-gray-500">
              <span class="material-symbols-outlined text-primary">{item.icon}</span>
              {item.href ? (
                <a href={item.href} class="hover:text-primary transition-colors">{item.text}</a>
              ) : (
                item.text
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-gray-400">
      <p>© 2025 MDA Analítica S.A.S. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        {legal.map((item) => (
          <a
            class="hover:text-primary transition-colors duration-300 focus:outline-none focus:text-primary"
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<script>
  // Smooth scroll for anchor links in footer
  document.querySelectorAll('.footer-link[href^="/#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      if (!href) return;

      // If we're on the homepage, scroll smoothly
      if (window.location.pathname === '/') {
        e.preventDefault();
        const targetId = href.replace('/', '');
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
          // Update URL without reload
          history.pushState(null, '', href);
        }
      }
    });
  });
</script>
