---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Verticales from '../components/Verticales.astro';
import IntelligenceHub from '../components/IntelligenceHub.astro';
import BlogPreview from '../components/BlogPreview.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
import ToastContainer from '../components/Toast';
---

<Layout
  title="MDA Analítica - Cumplimiento Normativo y Analítica Financiera"
  description="Especialistas en gestión de riesgos SARLAFT, SAGRILAFT y PTEE con analítica avanzada para la toma de decisiones ejecutivas en tiempo real."
>
  <Header />

  <main id="main-content">
    <Hero />
    <Verticales />
    <IntelligenceHub />
    <BlogPreview />
    <CtaSection />
  </main>

  <Footer />

  <!-- Toast notifications container -->
  <ToastContainer client:load />
</Layout>
